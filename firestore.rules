rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for security validation
    function isAuthenticated() {
      return request.auth != null;
    }

    // Public catalog collections - readable by all customers & guests
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    match /subcategories/{subcategoryId} {
      allow read: if true;
      allow write: if true;
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if true;
    }

    match /zones/{zoneId} {
      allow read: if true;
      allow write: if true;
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if true;
    }

    match /sliders/{sliderId} {
      allow read: if true;
      allow write: if true;
    }

    // Service Orders - Customers can create bookings, providers & admins can update statuses
    match /orders/{orderId} {
      allow read: if true;
      allow create: if request.resource.data.customerName is string 
                    && request.resource.data.amount is number;
      allow update, delete: if true;
    }

    // Service Providers - Profile, ratings, KYC details
    match /providers/{providerId} {
      allow read: if true;
      allow write: if true;
    }

    // Registered Users & Customer Profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // System Settings & Operational Configuration
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
