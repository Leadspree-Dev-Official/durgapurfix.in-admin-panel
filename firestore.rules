rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Web & Mobile Service Catalogs
    match /categories/{categoryId} {
      allow read, write: if true;
    }
    match /durgapur_categories/{categoryId} {
      allow read, write: if true;
    }
    match /subcategories/{subcategoryId} {
      allow read, write: if true;
    }
    match /services/{serviceId} {
      allow read, write: if true;
    }
    match /zones/{zoneId} {
      allow read, write: if true;
    }
    match /coupons/{couponId} {
      allow read, write: if true;
    }
    match /sliders/{sliderId} {
      allow read, write: if true;
    }
    match /durgapur_sliders/{sliderId} {
      allow read, write: if true;
    }

    // 2. Orders & Customer Bookings
    match /orders/{orderId} {
      allow read, write: if true;
    }
    match /durgapur_bookings/{bookingId} {
      allow read, write: if true;
    }
    match /bookings/{bookingId} {
      allow read, write: if true;
    }
    match /durgapur_orders/{orderId} {
      allow read, write: if true;
    }

    // 3. Service Providers & Technicians
    match /providers/{providerId} {
      allow read, write: if true;
    }
    match /durgapur_professionals/{providerId} {
      allow read, write: if true;
    }

    // 4. Users, Notifications & System Settings
    match /users/{userId} {
      allow read, write: if true;
    }
    match /durgapur_users/{userId} {
      allow read, write: if true;
    }
    match /notifications/{notificationId} {
      allow read, write: if true;
    }
    match /push_notifications/{notificationId} {
      allow read, write: if true;
    }
    match /settings/{settingId} {
      allow read, write: if true;
    }
    match /appointment_slots/{slotId} {
      allow read, write: if true;
    }
  }
}
